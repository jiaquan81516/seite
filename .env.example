# Server-only. Copy to .env; never put keys in VITE_* variables.
# Use a Google project on the unpaid free tier; do not enable billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after checking the project uses the unpaid free tier.
AI_FREE_TIER_CONFIRMED=false

# Optional fallback keys from free, unbilled accounts. Never add credits.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
# Only :free models or openrouter/free are accepted.
OPENROUTER_MODEL=openrouter/free

# Optional private mode. Install this vision model locally with Ollama.
OLLAMA_ENABLED=false
OLLAMA_MODEL=gemma3:4b

# Optional: AI messages allowed per client per 24 hours (default 100)
# CHAT_DAILY_LIMIT=100

# Vercel only: a shared counter so the daily limit holds across all instances.
# Add an Upstash Redis store from Vercel's Storage tab; it sets these for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
